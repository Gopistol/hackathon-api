# 로컬: 이 파일을 .env 로 복사. 서버: /etc/hackathon/hackathon.env 에 같은 키로 작성.
# .env 는 절대 커밋하지 않는다 (.gitignore 에 포함).
APP_NAME=Market Shorts API
ROOT_PATH=
# 프론트 배포 주소가 정해지면 콤마로 이어서 추가
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Vercel/Netlify 무료 주소(미리보기 포함) 허용. 비우면 끔
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.(vercel\.app|netlify\.app)$

# 서버에서는 절대경로 (슬래시 4개): sqlite:////opt/hackathon/data/app.db
DATABASE_URL=sqlite:///./data/app.db
# /media 로 공개되는 영상·썸네일·자막. 서버: /opt/hackathon/data/media
MEDIA_DIR=./data/media
# 사장님 원문 음성 (비공개). 서버: /opt/hackathon/data/audio
AUDIO_DIR=./data/audio

# LLM: openai | anthropic | mock
# 선택한 프로바이더의 API 키가 비어 있으면 mock 으로 동작한다 (STT·정리·번역·자막 전부 고정 응답, 토큰 0).
LLM_PROVIDER=openai

# OpenAI: STT·정리·번역·자막에 같은 키를 쓴다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# 등록 질문·확인 문장을 소리로 읽어 주는 음성 합성
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# ElevenLabs 가 있으면 등록 음성은 이쪽을 먼저 쓴다. 비우면 OpenAI 음성
# 목소리는 키 계정의 Voice Library 에 추가해 둔다 (기본: Sora - Warm & Expressive)
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=JpGoUJuLFthrFkcdBy4k
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# 숏폼 더빙(사장님 목소리 복제) 모델. 키가 없으면 OpenAI 목소리로 더빙
ELEVENLABS_DUB_MODEL=eleven_multilingual_v2
# 영상에 넣는 자막 글꼴. 서버는 sudo apt install fonts-noto-cjk 후 기본값 그대로
# Windows 로컬: SUBTITLE_FONT=Malgun Gothic / SUBTITLE_FONT_ZH=Microsoft YaHei (SUBTITLE_FONTS_DIR 는 비워 둔다.
# 폴더를 주면 그 안 글꼴을 전부 메모리에 올려 렌더링 하나가 1GB 넘게 쓴다)
SUBTITLE_FONT=Noto Sans CJK KR
SUBTITLE_FONT_ZH=Noto Sans CJK SC
SUBTITLE_FONTS_DIR=
OPENAI_MAX_OUTPUT_TOKENS=2048
# 초 단위. 실패하면 단계마다 대체 동작이 있어 짧게 두고 재시도는 하지 않는다
OPENAI_TIMEOUT=15
OPENAI_MAX_RETRIES=0

# Anthropic (선택, LLM_PROVIDER=anthropic 일 때. 음성 인식은 지원하지 않음)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_EFFORT=medium

# (선택) Google Geocoding API 키. 서버 IP 로 제한한 키를 쓴다. 비우면 가게 좌표는 시장 좌표 근처.
# 프론트용 Maps JavaScript API 키(HTTP referrer 제한)와는 별개.
GOOGLE_MAPS_API_KEY=

# POST /api/v1/admin/reset 의 X-Admin-Token. 비우면 리셋 꺼짐
ADMIN_TOKEN=

# true 면 피드에 시연 영상(demo/showcase 또는 임시 영상)만 보인다. 실시간 생성 영상은 피드에 안 올라감
FEED_DEMO_ONLY=true

# 비우면 PATH 의 ffmpeg, 없으면 imageio-ffmpeg 내장 바이너리
FFMPEG_PATH=
