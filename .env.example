# 로컬: 이 파일을 .env 로 복사. 서버: /etc/hackathon/hackathon.env 에 같은 키로 작성.
# .env 는 절대 커밋하지 않는다 (.gitignore 에 포함).
APP_NAME=Hackathon API
# /hack 경로 방식으로 붙일 때만 /hack
ROOT_PATH=
# 프론트 배포 주소가 정해지면 콤마로 이어서 추가
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 기본 SQLite. 서버에서는 절대경로 권장 (슬래시 4개): sqlite:////opt/hackathon/data/app.db
DATABASE_URL=sqlite:///./data/app.db
# MySQL (기존 billage-mysql 컨테이너의 별도 DB·계정)
# DATABASE_URL=mysql+pymysql://hackathon:<비밀번호>@127.0.0.1:3306/hackathon

# MinIO (기존 billage-minio, 별도 버킷). 비우면 파일 기능 꺼짐.
S3_ENDPOINT_URL=
# S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hackathon

# LLM: openai | anthropic | mock
# 선택한 프로바이더의 API 키가 비어 있으면 mock 으로 동작한다 (토큰 0).
LLM_PROVIDER=openai

# OpenAI: https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=1024
# 초 단위. 재시도 1회가 있어 최악의 경우 약 2배 걸린다
OPENAI_TIMEOUT=30

# Anthropic (선택, LLM_PROVIDER=anthropic 일 때)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_EFFORT=medium
